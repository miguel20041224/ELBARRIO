# Variables del frontend. Vite sólo expone al navegador las que empiezan por VITE_.
#
# Desarrollo: ya viene resuelto en .env.development (versionado). No hace falta
# copiar este archivo salvo que quieras apuntar a otro backend; en ese caso creá
# .env.local, que está en .gitignore.
#
# Producción (Vercel): definí VITE_API_URL en Project Settings > Environment
# Variables. Es obligatoria: sin ella el build falla en tiempo de ejecución con un
# mensaje explícito en vez de pedir a un dominio equivocado en silencio.

# URL absoluta de la API, con el prefijo /api y SIN barra final.
VITE_API_URL=http://localhost:8000/api

# Opcional. Tiempo máximo por petición en milisegundos (por defecto 60000).
# Un valor alto cubre el cold start del plan gratuito de Render (~50 s).
VITE_API_TIMEOUT_MS=60000
