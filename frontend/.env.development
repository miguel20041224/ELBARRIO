# Desarrollo local. Se versiona a propósito: no contiene secretos y hace que
# `npm run dev` funcione recién clonado el repositorio.
#
# La URL es absoluta y de otro origen (puerto 8000 frente al 5173 del frontend),
# así que el desarrollo ejercita CORS de verdad, igual que producción.
VITE_API_URL=http://localhost:8000/api
