# Variables del backend. Copiá este archivo a .env para desarrollo local.

# development | production
ENVIRONMENT=development

# SQLite para desarrollo. En producción usá PostgreSQL:
#   postgresql://usuario:clave@host:5432/basededatos
# Pegá la cadena tal cual la da el proveedor: el esquema se normaliza solo a
# postgresql+psycopg://, que es el driver instalado en la imagen.
# SQLite sobre el disco efímero de Render pierde todas las carreras en cada redeploy.
DATABASE_URL=sqlite:///./elbarrio.db

# Orígenes del navegador autorizados a llamar a la API.
# Se admiten cuatro formatos, elegí el que te resulte cómodo:
#   CORS_ORIGINS=https://mi-app.vercel.app
#   CORS_ORIGINS=https://mi-app.vercel.app,https://www.mi-dominio.com
#   CORS_ORIGINS=["https://mi-app.vercel.app"]
#   (sin definir: localhost:5173 y localhost:4173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Opcional. Expresión regular para los dominios de preview de Vercel, que cambian
# en cada commit y no se pueden enumerar. Anclá el patrón con ^ y $.
# CORS_ORIGIN_REGEX=^https://elbarrio-[a-z0-9-]+\.vercel\.app$

# Sólo si algún día la API usa cookies o cabecera Authorization. Con esto en true
# el comodín "*" deja de ser válido como origen.
CORS_ALLOW_CREDENTIALS=false
